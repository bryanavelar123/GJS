{
  "expo": {
    "name": "GJS Montagem de Móveis",
    "slug": "gjs",
    "version": "1.0.3",
    "orientation": "portrait",
    "icon": "./assets/images/logo-gjs.jpg",
    "scheme": "gjs",
    "userInterfaceStyle": "dark",
    "ios": {
      "icon": "./assets/expo.icon"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#000000",
        "foregroundImage": "./assets/images/logo-gjs.jpg",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.gjs.moveisplanejados",
      "versionCode": 4
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/logo-gjs.jpg"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#000000",
          "image": "./assets/images/logo-gjs.jpg",
          "imageWidth": 110
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": false
    },
    "newArchEnabled": false
  }
}
